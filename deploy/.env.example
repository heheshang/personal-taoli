# Taoli Trading System Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://taoli:taoli@localhost:5432/taoli

# Logging Configuration
RUST_LOG=info

# Trading Mode Configuration
# Options: observe, paper, live
TAOLI_MODE=observe

# Configuration File Path
TAOLI_CONFIG_PATH=./config/config.toml

# Server Configuration
TAOLI_SERVER_HOST=0.0.0.0
TAOLI_SERVER_PORT=8080

# Exchange Configuration
TAOLI_BINANCE_API_KEY=
TAOLI_BINANCE_API_SECRET=
TAOLI_BYBIT_API_KEY=
TAOLI_BYBIT_API_SECRET=

# Risk Management
TAOLI_MAX_POSITION_USD=1000
TAOLI_MAX_DAILY_TRADES=100

# Monitoring
TAOLI_PROMETHEUS_ENABLED=true
TAOLI_PROMETHEUS_PORT=9090

# Backup Configuration
TAOLI_BACKUP_ENABLED=true
TAOLI_BACKUP_INTERVAL_HOURS=24
TAOLI_BACKUP_RETENTION_DAYS=30
